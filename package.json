{
  "name": "personal-config",
  "version": "0.5.0",
  "description": "A terminal wizard that sets up an agent-driven working style in your repos — a ledger, a board, a working standard, and the rules your agent reads before it writes code.",
  "keywords": [
    "cli",
    "agent",
    "coding-agent",
    "claude-code",
    "ledger",
    "handoff",
    "working-standard",
    "setup-wizard"
  ],
  "author": "Zach Short (https://zacharyshort.com)",
  "license": "MIT",
  "homepage": "https://zacharyshort.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zach-short/personal-config.git"
  },
  "bugs": {
    "url": "https://github.com/zach-short/personal-config/issues"
  },
  "type": "module",
  "bin": {
    "personal-config": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "catalog.json",
    "standard",
    "templates",
    "profiles",
    "docs/choices"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --packages=external --outfile dist/cli.js",
    "prepack": "bun run build",
    "setup": "bun run src/cli.ts setup",
    "catalog": "bun run src/cli.ts catalog",
    "doctor": "bun run src/cli.ts doctor",
    "undo": "bun run src/cli.ts undo",
    "test": "bun test",
    "fixtures": "bun run tests/make-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests tools",
    "format": "biome format --write src tests tools"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "5.9.2"
  },
  "packageManager": "bun@1.2.9",
  "engines": {
    "node": ">=20"
  }
}
