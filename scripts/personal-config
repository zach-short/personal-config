#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# name:one-line description for the dev-only tasks. The CLI's own subcommands are not listed
# here: cli_commands reads them from `src/cli.ts --help`, so a command added to the CLI reaches
# this wrapper, its menu and its completion without an edit here.
DEV_COMMANDS=(
  "build:Bundle src/cli.ts to dist/cli.js"
  "test:Run the bun test suite"
  "typecheck:Typecheck with tsc --noEmit"
  "lint:Lint with biome"
  "format:Format with biome --write"
  "shell:Print the ~/.zshrc snippet for the personal-config function + completion"
  "help:List commands"
)

# The CLI's own subcommands run from the caller's directory, never from $ROOT: they act on
# whatever repo you are standing in, and `doctor .` or `setup` resolved against this checkout
# instead reads — or rewrites — personal-config's own documents. The CLI finds its templates
# through import.meta.url, so it does not need the cd.
cli() { bun "$ROOT/src/cli.ts" "$@"; }

# Dev tasks are about this checkout, so they, and only they, run inside it.
dev() { (cd "$ROOT" && bun run "$@"); }

# The CLI's subcommands as name:description lines, read from the usage block of its --help (the
# lines that start "  personal-config <name>"). A command with several usage lines, such as
# `passoff next` and `passoff claim`, appears once, with its first description.
cli_commands() {
  cli --help | awk '
    /^  personal-config [a-z]/ {
      name = $2
      if (name in seen) next
      seen[name] = 1
      # The usage (name, subword, arguments) ends at the first run of two spaces; the rest is
      # the description.
      line = $0
      sub(/^  personal-config +/, "", line)
      sub(/^[^ ]+( [^ ]+)*  +/, "", line)
      print name ":" line
    }'
}

all_commands() {
  cli_commands
  printf "%s\n" "${DEV_COMMANDS[@]}"
}

cmd_build() { dev build "$@"; }
cmd_test() { dev test "$@"; }
cmd_typecheck() { dev typecheck "$@"; }
cmd_lint() { dev lint "$@"; }
cmd_format() { dev format "$@"; }

cmd_help() {
  echo "usage: personal-config <command>"
  echo
  # A failed read of the CLI's list is said on stderr; the dev commands still print.
  local from_cli
  from_cli="$(cli_commands)" || {
    from_cli=""
    echo "personal-config: could not read the CLI's command list; showing the dev commands only" >&2
  }
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    printf "  %-10s %s\n" "${entry%%:*}" "${entry#*:}"
  done < <(printf "%s\n" "$from_cli" "${DEV_COMMANDS[@]}")
}

cmd_shell() {
  cat <<'EOF'
# personal-config is also this tool's own published CLI (`npx personal-config`, or on PATH
# after `bun link`) — only take over for our own subcommands, so `personal-config setup` run
# against some OTHER repo still reaches the real, installed CLI.
personal-config() {
  local subs; subs=("cd" "--complete" "--version" "-v" "--v" $("$HOME/Projects/personal-config/scripts/personal-config" --complete | cut -d: -f1))
  if [[ $# -eq 0 || " ${subs[*]} " == *" $1 "* ]]; then
    if [[ "$1" == "cd" ]]; then cd "$HOME/Projects/personal-config"; else "$HOME/Projects/personal-config/scripts/personal-config" "$@"; fi
  else
    command personal-config "$@"
  fi
}

_personal_config_complete() {
  local -a subcmds
  subcmds=("${(@f)$(personal-config --complete)}")
  _describe 'command' subcmds
}
compdef _personal_config_complete personal-config
EOF
}

cmd___complete() {
  all_commands
}

# A bare call at a terminal opens the CLI's own framed home (bare-command-home), not a picker.
# The dev tasks stay one word away: `personal-config help` lists them.
# Below, an fzf picker is kept for a terminal with no `bun`, where the CLI cannot start.
interactive_pick() {
  local lines
  lines="$(all_commands | while IFS= read -r entry; do
    printf "%-10s %s\n" "${entry%%:*}" "${entry#*:}"
  done)"
  echo "$lines" | fzf --prompt='personal-config> ' --height='~70%' --reverse --no-info \
    --header='select a command' | awk '{print $1}'
}

if [[ $# -eq 0 && -t 0 && -t 1 ]] && command -v bun >/dev/null 2>&1; then
  cli
  exit $?
fi

if [[ $# -eq 0 && -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
  picked="$(interactive_pick || true)"
  [[ -n "$picked" ]] || exit 0
  set -- "$picked"
fi

sub="${1:-help}"
shift || true

case "$sub" in
  build) cmd_build "$@" ;;
  test) cmd_test "$@" ;;
  typecheck) cmd_typecheck "$@" ;;
  lint) cmd_lint "$@" ;;
  format) cmd_format "$@" ;;
  shell) cmd_shell ;;
  --complete) cmd___complete ;;
  help|-h|--help) cmd_help ;;
  --version|-v|--v) cli --version ;;
  *)
    # Anything else is the CLI's, if the CLI lists it; otherwise print the usage.
    # A failed --help read (bun missing, a crash) stops here with a message, never falls through
    # to the usage with exit 0. An unknown name prints the usage on stderr and exits 1.
    known="$(cli_commands)" || { echo "personal-config: could not read the CLI's command list" >&2; exit 1; }
    if printf "%s\n" "$known" | cut -d: -f1 | grep -qxF -- "$sub"; then
      cli "$sub" "$@"
    else
      echo "personal-config: unknown command '$sub'" >&2
      cmd_help >&2
      exit 1
    fi
    ;;
esac
